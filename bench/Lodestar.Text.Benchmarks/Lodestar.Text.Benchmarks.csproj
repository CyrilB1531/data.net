<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires an optimized, non-debug build to run. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- V6 of #437 asks how TensorPrimitives compares; the bench references it, src does not. -->
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

  <!--
    The .NET incumbents #438 names for Lodestar.Fuzzy. They are referenced by the
    benchmarks and by nothing else: no src/ project may take a dependency, and
    tools/check_nuspec_dependencies.py asserts that the shipped packages carry none.
    Pinned exactly, like every other version here, so a table in
    docs/guides/performance.md names a version that can be reproduced.
  -->
  <ItemGroup>
    <PackageReference Include="Fastenshtein" Version="1.0.12" />
    <PackageReference Include="Quickenshtein" Version="1.5.1" />
    <PackageReference Include="F23.StringSimilarity" Version="7.0.1" />
    <PackageReference Include="Raffinert.FuzzySharp" Version="6.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lodestar.Text/Lodestar.Text.csproj" />
    <ProjectReference Include="../../src/Lodestar.Fuzzy/Lodestar.Fuzzy.csproj" />
    <ProjectReference Include="../../src/Lodestar.Embeddings/Lodestar.Embeddings.csproj" />
    <ProjectReference Include="../../src/Lodestar.Metrics/Lodestar.Metrics.csproj" />
  </ItemGroup>

  <!--
    The batch benchmark runs a model, and the only model this repository has is
    the synthetic one the test suite uses: weights are never committed
    (CONTRIBUTING.md). Linked from tests/oracles rather than copied, so there is
    one fixture and tools/build_tiny_models.py remains the single thing that
    produces it.
  -->
  <ItemGroup>
    <None Include="../../tests/oracles/tiny_embedder.onnx" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
  </ItemGroup>

</Project>
