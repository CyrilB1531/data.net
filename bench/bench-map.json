{
  "_why": "Which benchmarks a change makes worth re-running. Deliberately coarse: a benchmark run for nothing costs minutes, one not run hides a regression, so the globs are directories and over-include on purpose. 'benchmarks' are BenchmarkDotNet classes, measured against themselves; 'harnesses' are the cross-language pairs, which is where the claim against rapidfuzz is actually measured. tools/check_bench_map.py refuses either kind if this file does not name it. A harness also names the corpus generators it needs: those corpora are written rather than committed, and a runner has none of them.",
  "always": [
    "src/Shared/**",
    "bench/Lodestar.Text.Benchmarks/BenchCorpus.cs",
    "bench/Lodestar.Text.Benchmarks/Program.cs",
    "bench/Lodestar.Text.Benchmarks/CrossLang/**",
    "bench/python/harness.py",
    "bench/compare.py",
    "bench/corpus/**"
  ],
  "benchmarks": {
    "BatchEmbeddingBenchmarks": [
      "src/Lodestar.Embeddings/Tokenization/**",
      "src/Lodestar.Embeddings/Pooling/**"
    ],
    "BpeBenchmarks": [
      "src/Lodestar.Embeddings/Tokenization/**",
      "src/Lodestar.Embeddings/Persistence/**"
    ],
    "BpeScalingBenchmarks": [
      "src/Lodestar.Embeddings/Tokenization/**",
      "src/Lodestar.Embeddings/Persistence/**"
    ],
    "FuzzBenchmarks": [
      "src/Lodestar.Fuzzy/**",
      "src/Lodestar.Text/Distances/**",
      "src/Lodestar.Text/Text/**"
    ],
    "IndelBenchmarks": [
      "src/Lodestar.Text/Distances/**",
      "src/Lodestar.Text/Text/**"
    ],
    "LcsGateBenchmarks": [
      "src/Lodestar.Text/Distances/**",
      "src/Lodestar.Text/Text/**"
    ],
    "LevenshteinBenchmarks": [
      "src/Lodestar.Text/Distances/**",
      "src/Lodestar.Text/Text/**"
    ],
    "LevenshteinCodePointBenchmarks": [
      "src/Lodestar.Text/Distances/**",
      "src/Lodestar.Text/Text/**"
    ],
    "MetricsBenchmarks": [
      "src/Lodestar.Metrics/**"
    ],
    "PersistenceBenchmarks": [
      "src/Lodestar.Embeddings/Persistence/**",
      "src/Lodestar.Embeddings/Search/**",
      "src/Lodestar.Embeddings/Tokenization/**",
      "src/Lodestar.Text/Vectorization/**",
      "src/Lodestar.Text/Persistence/**"
    ],
    "StopWordBenchmarks": [
      "src/Lodestar.Text/Vectorization/**",
      "src/Lodestar.Text/Text/**"
    ],
    "VectorMathBenchmarks": [
      "src/Lodestar.Embeddings/Search/**"
    ],
    "VectorizerBenchmarks": [
      "src/Lodestar.Text/Vectorization/**",
      "src/Lodestar.Text/Text/**"
    ]
  },
  "harnesses": {
    "levenshtein": {
      "subcommand": "compare",
      "python": "bench/python/bench_levenshtein.py",
      "compare": "",
      "generate": [],
      "sources": [
        "src/Lodestar.Text/Distances/**",
        "src/Lodestar.Text/Text/**"
      ]
    },
    "indel": {
      "subcommand": "compare-indel",
      "python": "bench/python/bench_indel.py",
      "compare": "indel",
      "generate": [],
      "sources": [
        "src/Lodestar.Text/Distances/**",
        "src/Lodestar.Text/Text/**"
      ]
    },
    "metrics": {
      "subcommand": "compare-metrics",
      "python": "bench/python/bench_metrics.py",
      "compare": "metrics",
      "generate": [
        "bench/corpus/generate_metrics.py"
      ],
      "sources": [
        "src/Lodestar.Metrics/**"
      ]
    },
    "persistence": {
      "subcommand": "compare-persistence",
      "python": "bench/python/bench_persistence.py",
      "compare": "persistence",
      "generate": [
        "bench/corpus/generate_vocabs.py"
      ],
      "sources": [
        "src/Lodestar.Embeddings/Persistence/**",
        "src/Lodestar.Embeddings/Search/**",
        "src/Lodestar.Text/Vectorization/**",
        "src/Lodestar.Text/Persistence/**"
      ]
    }
  }
}
