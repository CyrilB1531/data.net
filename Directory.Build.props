<Project>

  <!-- Shared properties for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Warnings are errors everywhere: src, tests and bench alike. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The Sonar rules that gate the pull request also gate the build, so a
         finding is a compile error on the machine that wrote the code rather
         than a round trip through SonarCloud. Pinned once here and read from
         three places, because the areas reference packages differently: src/ and
         tests/ take it through Central Package Management, bench/ has none and
         names the version on the PackageReference itself. See
         docs/decisions/0015-sonar-rules-in-the-build.md. -->
    <DataNetSonarAnalyzerVersion>10.20.0.135146</DataNetSonarAnalyzerVersion>

    <!-- Package identity / provenance (§10). Everything genuinely shared lives
         here; <Version> deliberately does not, because the three packages
         release on independent cadences. Each publishable project declares its
         own in a sibling Version.props — see
         docs/decisions/0012-per-package-versioning.md. -->
    <Company>Cyril BRUNET</Company>
    <Authors>Cyril BRUNET</Authors>
    <Copyright>Copyright 2026 Cyril BRUNET</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CyrilB1531/data.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CyrilB1531/data.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols + deterministic CI builds for a clean published package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Ship the repository README inside every published package (NuGet renders it). -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
