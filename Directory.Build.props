<Project>

  <!-- Shared properties for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Warnings are errors everywhere: src, tests, bench and samples alike.
         samples/ was always covered — with no Directory.Build.props of its own,
         MSBuild's upward search reached this file — and keeps it explicitly now
         that samples/Directory.Build.props imports it, because a nearer
         Directory.Build.props stops that search and would have dropped it. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The .NET code-quality rules, on and enforced. Two of them are the reason
         this exists: CA1845 and CA1859 are `note` severity by default, so they
         never appear in build output — while the compiler still writes them to
         the SARIF error log the Sonar scanner reads, and the quality gate counts
         them against a threshold of zero. AnalysisMode=All raises every rule to
         warning, which TreatWarningsAsErrors above turns into a build failure.

         EnableNETAnalyzers is not decorative: the SDK enables these analysers
         only for net5.0 and later, so without it the netstandard2.0 leg of every
         multi-targeted project goes unanalysed.

         AnalysisLevel is pinned rather than `latest` for the reason
         docs/decisions/0015-sonar-rules-in-the-build.md gives about the
         SonarAnalyzer pin: adding rules to a build where warnings are errors
         breaks it, so the bump must be an edit somebody makes on purpose rather
         than a side effect of CI resolving a newer 10.0.x SDK.

         What each area switches back off, and why, is in that area's
         Directory.Build.props. See
         docs/decisions/0019-the-net-analysers-run-in-the-build-too.md. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>

    <!-- The Sonar rules that gate the pull request also gate the build, so a
         finding is a compile error on the machine that wrote the code rather
         than a round trip through SonarCloud. Pinned once here and read from
         four places, because the areas reference packages differently: src/ and
         tests/ take it through Central Package Management, while bench/ and
         samples/ have none and name the version on the PackageReference itself.
         See docs/decisions/0015-sonar-rules-in-the-build.md and
         docs/decisions/0019-the-net-analysers-run-in-the-build-too.md. -->
    <DataNetSonarAnalyzerVersion>10.20.0.135146</DataNetSonarAnalyzerVersion>

    <!-- Package identity / provenance (§10). Everything genuinely shared lives
         here; <Version> deliberately does not, because the three packages
         release on independent cadences. Each publishable project declares its
         own in a sibling Version.props — see
         docs/decisions/0012-per-package-versioning.md. -->
    <Company>Cyril BRUNET</Company>
    <Authors>Cyril BRUNET</Authors>
    <Copyright>Copyright 2026 Cyril BRUNET</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CyrilB1531/data.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CyrilB1531/data.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols + deterministic CI builds for a clean published package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The rules the server's quality profile enables and SonarAnalyzer.CSharp ships
       disabled. Generated by tools/generate_sonar_globalconfig.py; the Lint job
       regenerates and diffs it on every pull request, so a profile change is caught
       here rather than three minutes after a push.

       Not wired through an explicit <GlobalAnalyzerConfigFiles> item: the SDK's own
       Microsoft.Managed.Core.targets (DiscoverGlobalAnalyzerConfigFiles, on by
       default) already globs every ancestor directory of every compiled file for a
       file literally named .globalconfig, and the repository root — where this file
       lives — is an ancestor of every project here, samples included. Adding the
       same path a second time does not layer; MSBuild logs
       'MultipleGlobalAnalyzerKeys' for the clash and discards the severity for every
       rule this file sets, which was measured to silently turn the whole mechanism
       off (verified with an S107 canary: with the explicit item added unconditionally,
       the canary built clean; with it gone, S107 fired as expected). The ItemGroup
       below exists only as a fallback for the day someone disables that discovery;
       while it is on, this ItemGroup is inert by design. See issue #109. -->
  <ItemGroup Condition="'$(DiscoverGlobalAnalyzerConfigFiles)' == 'false'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).globalconfig" />
  </ItemGroup>

  <!-- Ship the repository README inside every published package (NuGet renders it). -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
