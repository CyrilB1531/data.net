<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes Lodestar as a NuGet package, not as a ProjectReference — that
    distinction is the whole value of this project. Nothing else in the
    repository exercises the packages, so packaging defects would otherwise reach
    consumers before they reach CI.

    Deliberately NOT in Lodestar.slnx: inside the solution, ProjectReference
    resolution would quietly satisfy these references and the sample would prove
    nothing.

    net10.0 only for now, which resolves lib/net10.0. Adding a net8.0 target would
    additionally resolve lib/netstandard2.0 and exercise that dependency group
    (System.Memory, System.Numerics.Vectors) the way a real consumer would; the
    netstandard2.0 *assemblies* are covered by the mirror test projects, but the
    netstandard2.0 *package assets* are not yet consumed by anything.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    One version property per package now that they release independently.
    Importing each project's Version.props keeps the original guarantee intact:
    the sample tracks whatever `dotnet pack` just produced instead of pinning
    numbers that go stale at the next release — it just needs one source per
    package instead of one repository-wide $(Version). See
    docs/decisions/0012-per-package-versioning.md.
  -->
  <Import Project="../../src/Lodestar.Text/Version.props" />
  <Import Project="../../src/Lodestar.Embeddings/Version.props" />
  <Import Project="../../src/Lodestar.Fuzzy/Version.props" />
  <Import Project="../../src/Lodestar.Metrics/Version.props" />
  <Import Project="../../src/Lodestar.Conformal/Version.props" />
  <Import Project="../../src/Lodestar.Abstractions/Version.props" />
  <Import Project="../../src/Lodestar.Decomposition/Version.props" />

  <ItemGroup>
    <PackageReference Include="Lodestar.Text" Version="$(LodestarTextVersion)" />
    <PackageReference Include="Lodestar.Fuzzy" Version="$(LodestarFuzzyVersion)" />
    <PackageReference Include="Lodestar.Embeddings" Version="$(LodestarEmbeddingsVersion)" />
    <PackageReference Include="Lodestar.Metrics" Version="$(LodestarMetricsVersion)" />
    <PackageReference Include="Lodestar.Conformal" Version="$(LodestarConformalVersion)" />
    <PackageReference Include="Lodestar.Abstractions" Version="$(LodestarAbstractionsVersion)" />
    <PackageReference Include="Lodestar.Decomposition" Version="$(LodestarDecompositionVersion)" />
  </ItemGroup>

</Project>
