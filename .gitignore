# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
# A local NUGET_PACKAGES for the sample and doc-snippet runs, which must not
# resolve the published packages (decision 0009). CI puts it under runner.temp.
.nuget-sample/

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# Cross-language bench results are machine-specific (not authoritative)
bench/results/

# Benchmark vocabulary corpus is generated (bench/corpus/generate_vocabs.py)
bench/corpus/vocabs/

# Benchmark metrics corpus is generated (bench/corpus/generate_metrics.py)
bench/corpus/metrics/

# Test / coverage
[Tt]est[Rr]esults/
*.trx
coverage*.json
coverage*.xml
*.coverage

# Python oracle tooling (dev-time only, never shipped)
.venv*/
tools/__pycache__/
*.pyc

# IDE / OS
.vs/
.idea/
.vscode/
*.user
.DS_Store

# Guide snippets are extracted from the Markdown on every run (tools/extract_doc_snippets.py).
# Any sample project, not the one that has it today: naming a single project left the
# vestige of an older name showing as untracked noise in every git status (#260).
samples/*/Generated/
