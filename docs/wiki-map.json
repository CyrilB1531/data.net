{
  "root": [
    "docs/equivalence.md",
    "docs/guides/performance.md",
    "docs/decisions/*.md",
    "docs/migration/*.md"
  ],
  "packages": {
    "Lodestar.Text": {
      "wiki": "Text",
      "pages": [
        "docs/guides/quickstart.md",
        "docs/guides/vectorization.md",
        "docs/reference/text/*.md",
        "docs/reference/text/*/*.md"
      ],
      "covered": {
        "Lodestar.Text.Distances": "docs/reference/text/distances"
      }
    },
    "Lodestar.Embeddings": {
      "wiki": "Embeddings",
      "pages": [
        "docs/guides/embeddings.md",
        "docs/reference/embeddings/*.md"
      ],
      "covered": {}
    },
    "Lodestar.Fuzzy": {
      "wiki": "Fuzzy",
      "pages": [
        "docs/guides/migrating-from-rapidfuzz.md",
        "docs/reference/fuzzy/*.md"
      ],
      "covered": {}
    },
    "Lodestar.Metrics": {
      "wiki": "Metrics",
      "pages": [
        "docs/guides/metrics.md",
        "docs/reference/metrics/*.md",
        "docs/reference/metrics/*/*.md"
      ],
      "covered": {
        "Lodestar.Metrics": [
          "docs/reference/metrics/classification",
          "docs/reference/metrics/regression",
          "docs/reference/metrics/clustering",
          "docs/reference/metrics/ranking"
        ]
      }
    }
  }
}
