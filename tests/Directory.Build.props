<Project>

  <!-- Chain to the repository-root Directory.Build.props (MSBuild otherwise stops
       at the nearest one). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The .NET code-quality rules that a *test* trips by being a test. Each is
       off for this area only, and for a reason that does not apply to src/:
         CA1707 — Method_Case_Expected is the xunit naming convention.
         CA1515 — xunit requires a public test class to discover it.
         CA1062 — a test helper's arguments come from the suite, not a caller.
         CA1849 — the suite calls the synchronous Save on purpose, to compare it
                  against SaveAsync; that comparison is what the tests assert.
         CA2007 — a test awaits with no synchronization context to capture, so
                  ConfigureAwait is noise; the rule reaches this repository only
                  through `dotnet format`'s own Roslyn workspace, never through
                  the build, because Microsoft.NET.Test.Sdk makes these projects
                  OutputType=Exe and CA2007 skips executables there.
       See docs/decisions/0019-the-net-analysers-run-in-the-build-too.md. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1062;CA1849;CA2007</NoWarn>
  </PropertyGroup>

  <!-- Test code is held to the same rules as the code it tests: a test is read
       more often than it is written, and SonarCloud already reports on it. The
       version comes from the root Directory.Build.props, the package from
       tests/Directory.Packages.props. See
       docs/decisions/0015-sonar-rules-in-the-build.md. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
