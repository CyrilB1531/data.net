<Project>

  <!--
    Lodestar.Metrics owns its version here, independently of the other packages
    (see docs/decisions/0012-per-package-versioning.md).

    0.1.0 shipped on 2026-08-14, this package's first release. It creates no
    inter-package edge — nothing depends on it and it depends on nothing — so
    unlike Lodestar.Text it releases on its own schedule, which is why its number
    trails the other three rather than matching them.
  -->
  <PropertyGroup>
    <LodestarMetricsVersion>0.3.0</LodestarMetricsVersion>
  </PropertyGroup>

</Project>
