<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>DataNet.Fuzzy</RootNamespace>
    <PackageId>DataNet.Fuzzy</PackageId>
    <Description>Applied fuzzy string matching for .NET (rapidfuzz-compatible fuzz ratios, process.extract, dedup). No external dependencies.</Description>
    <PackageTags>fuzzy;matching;rapidfuzz;fuzzywuzzy;dedup;nlp;datanet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DataNet.Text/DataNet.Text.csproj" />
  </ItemGroup>

</Project>
