<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(DataNetFuzzyVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>DataNet.Fuzzy</RootNamespace>
    <PackageId>DataNet.Fuzzy</PackageId>
    <Description>Applied fuzzy string matching for .NET (rapidfuzz-compatible fuzz ratios, process.extract, dedup). No external dependencies.</Description>
    <PackageTags>fuzzy;matching;rapidfuzz;fuzzywuzzy;dedup;nlp;datanet</PackageTags>
  </PropertyGroup>

  <!--
    Fuzz.Ratio is Indel.NormalizedSimilarity × 100, so the dependency on
    DataNet.Text is real and permanent. What changed is how it is expressed: a
    PackageReference against the published package, so the build graph is the
    graph consumers see, and the two packages can release on their own cadences.

    The default — no property set — is the path CI packs and ships. The opt-in
    below exists only so that editing DataNet.Text and DataNet.Fuzzy in the same
    branch does not require a pack-and-restore cycle per edit:

        export DataNetUseProjectRefs=true

    MSBuild reads environment variables as properties, so that one export covers
    dotnet build, dotnet test and the IDE. It is never set in CI, and the packed
    .nuspec is asserted there — see docs/decisions/0012-per-package-versioning.md.
  -->
  <ItemGroup Condition="'$(DataNetUseProjectRefs)' == 'true'">
    <ProjectReference Include="../DataNet.Text/DataNet.Text.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DataNetUseProjectRefs)' != 'true'">
    <PackageReference Include="DataNet.Text" />
  </ItemGroup>

  <!-- Loud on purpose: a local build that silently differed from the shipped one
       is the failure mode this whole arrangement is designed to avoid. -->
  <Target Name="WarnOnLocalProjectRefs" BeforeTargets="Build"
          Condition="'$(DataNetUseProjectRefs)' == 'true'">
    <Message Importance="high"
             Text="DataNet.Fuzzy: DataNetUseProjectRefs=true — referencing DataNet.Text by project, not by package. This is the developer loop, not what ships." />
  </Target>

</Project>
