<Project>

  <!--
    DataNet.Embeddings owns its version here, independently of the other packages
    (see docs/decisions/0012-per-package-versioning.md).

    0.3.0 shipped on 2026-08-14 — the vocabulary loaders, the BPE normalizer and
    the lossy byte-level decode. This is the next declared version, and it must
    stay ahead of the feed: a number already published would make two different
    assemblies answer to the same identity.
  -->
  <PropertyGroup>
    <DataNetEmbeddingsVersion>0.4.0</DataNetEmbeddingsVersion>
  </PropertyGroup>

</Project>
