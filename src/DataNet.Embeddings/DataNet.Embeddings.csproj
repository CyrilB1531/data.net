<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(DataNetEmbeddingsVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>DataNet.Embeddings</RootNamespace>

    <PackageId>DataNet.Embeddings</PackageId>
    <Description>Sub-word tokenizers, pooling and semantic (kNN) search for .NET. ONNX Runtime is isolated to this package so DataNet.Text stays dependency-free.</Description>
    <PackageTags>embeddings;onnx;wordpiece;semantic-search;knn;nlp;datanet</PackageTags>
  </PropertyGroup>

  <!-- ONNX Runtime is the one external dependency, isolated to this package so
       DataNet.Text stays dependency-free. Only the OnnxTextEmbedder type uses it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

</Project>
